{
  "info": {
    "_postman_id": "31093184-f303-4f92-815d-6db8fd35b68f",
    "name": "School Management System API Clude v2",
    "description": "Bangladeshi secondary school (Class 6-10) backend — Django + DRF. Run 'Login (admin)' first to auto-populate {{access_token}}, and 'Login (teacher)' to populate {{teacher_token}} for permission testing. Requires `python manage.py seed_data` to have real IDs to test against.",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
    "_exporter_id": "51519080"
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", data.access);",
                  "pm.collectionVariables.set(\"refresh_token\", data.refresh);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin12345\"\n}"
            },
            "url": "{{base_url}}/api/auth/token"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/token/refresh"
          },
          "response": []
        },
        {
          "name": "Login (teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"teacher_token\", data.access);",
                  ""
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"teacher001\",\n  \"password\": \"teacher12345\"\n}"
            },
            "url": "{{base_url}}/api/auth/token"
          },
          "response": []
        }
      ]
    },
